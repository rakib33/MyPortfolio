            <div class="social-icons mb-4">
                @* social-links *@
                <a target="_blank" href="https://www.linkedin.com/in/rakibul33/"><i class="fab fa-linkedin-in"></i></a>
                <a target="_blank" href="https://github.com/rakib33"><i class="fab fa-github"></i></a>
